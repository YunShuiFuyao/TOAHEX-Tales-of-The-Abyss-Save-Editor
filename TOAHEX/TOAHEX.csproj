<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TOAHEX</RootNamespace>
    <AssemblyName>TOAHEX</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>Icon\File.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- 入口与核心：存档读写 / 校验 / 偏移 / 转换 -->
    <Compile Include="Program.cs" />
    <Compile Include="SaveOffsets.cs" />
    <Compile Include="ChecksumHelper.cs" />
    <Compile Include="SaveData.cs" />
    <Compile Include="Ps2To3dsConverter.cs" />
    <Compile Include="TblCodec.cs" />
    <Compile Include="ItemData.cs" />
    <Compile Include="LanguageConfig.cs" />
    <Compile Include="Lang.cs" />

    <!-- 数据层：Database/ -->
    <Compile Include="Database\DatDataLoader.cs" />
    <Compile Include="Database\ItemDatabase.cs" />
    <Compile Include="Database\ArteDatabase.cs" />
    <Compile Include="Database\ADSkillDatabase.cs" />
    <Compile Include="Database\TitleDatabase.cs" />
    <Compile Include="Database\CookingDatabase.cs" />
    <Compile Include="Database\EquipIndexDatabase.cs" />
    <Compile Include="Database\KyouritsufuDatabase.cs" />
    <Compile Include="Database\StoryJumpDatabase.cs" />
    <Compile Include="Database\SideQuestJumpDatabase.cs" />

    <!-- 界面层：Form/（MainForm.cs 与 MainForm.Designer.cs 必须同名成对，勿单独改名） -->
    <Compile Include="Form\MainForm.cs" />
    <Compile Include="Form\MainForm.Designer.cs" />
    <Compile Include="Form\JumpSearchForm.cs" />
    <Compile Include="Form\ArteSelectForm.cs" />
    <Compile Include="Form\EquipSelectForm.cs" />
    <Compile Include="Form\TitleSelectForm.cs" />
    <Compile Include="Form\ConvertPs2Form.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon\luke.png" />
    <EmbeddedResource Include="Icon\tear.png" />
    <EmbeddedResource Include="Icon\jade.png" />
    <EmbeddedResource Include="Icon\anise.png" />
    <EmbeddedResource Include="Icon\guy.png" />
    <EmbeddedResource Include="Icon\natalia.png" />
    <EmbeddedResource Include="Icon\asch.png" />
    <EmbeddedResource Include="Icon\pen.png" />
    <EmbeddedResource Include="Icon\File.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- 码表全项目只保留一份（项目根目录 new_patched.tbl）。
         此处以链接方式嵌入，Link 保证清单资源名仍为 TOAHEX.new_patched.tbl
         （TblCodec 按后缀 "new_patched.tbl" 查找资源，名称不可变）。 -->
    <EmbeddedResource Include="..\new_patched.tbl">
      <Link>new_patched.tbl</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\3ds_template.bin" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- 构建后把词典复制到 exe 同级目录（程序优先读取 BaseDirectory\Dictory） -->
  <Target Name="CopyDictory" AfterTargets="Build">
    <ItemGroup>
      <_DictFiles Include="$(MSBuildProjectDirectory)\..\Dictory\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(_DictFiles)" DestinationFolder="$(OutDir)Dictory" SkipUnchangedFiles="true" />
    <Message Text="词典已复制到 $(OutDir)Dictory" Importance="high" />
  </Target>
</Project>
